__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage

# Agent-local settings, which routinely contain absolute home paths. Keeping
# this out of .git/info/exclude matters: that file is local to one clone and
# never travels with the repository.
.claude/
.codex/

# Hypothesis keeps its example database beside the tests it ran.
.hypothesis/

# The live suite writes its invocation log and its lab credential here.
tests/live/.results/

# A developer's local Serena configuration.
.serena/
